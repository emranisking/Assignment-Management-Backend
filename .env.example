# Copy to .env and adjust. docker-compose sets these directly, so this file is a reference
# for running the API outside Docker (values map to appsettings via double-underscore keys).

ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=assignment_management;Username=postgres;Password=postgres
Jwt__Secret=CHANGE_ME_super_secret_key_at_least_32_chars_long!!
Jwt__Issuer=AssignmentManagement
Jwt__Audience=AssignmentManagement.Client
Jwt__ExpiryMinutes=120
Redis__ConnectionString=localhost:6379
Cache__Enabled=true
# Global Redis cache TTL (seconds)
Cache__ExpirySeconds=60
RabbitMq__Enabled=true
RabbitMq__Host=localhost
RabbitMq__Port=5672
RabbitMq__Username=guest
RabbitMq__Password=guest
Enrollment__UseAsyncProcessing=true
Storage__RootPath=storage
